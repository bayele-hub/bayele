# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── SokoClick (OHADA invoicing) — PROVISIONAL, see production spec header ─
SOKOCLICK_API_URL=https://api.sokoclick.com/v2
SOKOCLICK_API_KEY=your-sokoclick-key
SOKOCLICK_WEBHOOK_SECRET=your-webhook-signing-secret

# ── Google AI (Gemini 2.5 Flash — Proof-of-Post scoring) ─────────────────
GOOGLE_GENAI_API_KEY=your-gemini-key

# ── Resend (transactional email / digests) ───────────────────────────────
RESEND_API_KEY=your-resend-key
